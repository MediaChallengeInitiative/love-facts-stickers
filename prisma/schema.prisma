// Prisma schema for Love Facts Sticker Portal
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Sticker collection categories. Stored as String (not Prisma enum) so the
// Drive sync can set arbitrary values without schema changes per campaign.
// Conventional values: LOVE_FACTS, RED_FLAGS, MYTHS, FACT_CHECKS, OTHER.
model Collection {
  id            String    @id @default(cuid())
  name          String
  slug          String    @unique
  description   String?
  coverImage    String?
  driveFolderId String?   @unique
  sortOrder     Int       @default(0)
  featured      Boolean   @default(false)
  category      String    @default("LOVE_FACTS")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  stickers      Sticker[]

  @@index([category])
}

// Individual sticker assets
model Sticker {
  id              String     @id @default(cuid())
  title           String
  filename        String
  sourceUrl       String
  thumbnailUrl    String
  driveId         String?    @unique
  shortCode       String?    @unique
  mimeType        String?
  tags            String[]
  caption         String?
  seoDescription  String?
  width           Int?
  height          Int?
  fileSize        Int?

  // Curation: the 10 (or N) hero stickers Silas wants to actively push.
  isHero          Boolean    @default(false)
  heroRank        Int?
  heroCaption     String?

  // Aggregate engagement counters. Increment-only, no PII.
  shareCount      Int        @default(0)
  viewCount       Int        @default(0)
  usefulCount     Int        @default(0)

  collection      Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  collectionId    String
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  downloads       Download[]
  shares          ShareEvent[]

  @@index([collectionId])
  @@index([tags])
  @@index([isHero, heroRank])
  @@index([shareCount])
}

// Per-share event for granular analytics by channel.
model ShareEvent {
  id        String   @id @default(cuid())
  sticker   Sticker  @relation(fields: [stickerId], references: [id], onDelete: Cascade)
  stickerId String
  channel   String
  ipHash    String?
  createdAt DateTime @default(now())

  @@index([stickerId])
  @@index([channel])
  @@index([createdAt])
}

// Optional, post-action user feedback. Never blocking, never required.
model Feedback {
  id        String   @id @default(cuid())
  sentiment String?  // positive | neutral | negative
  missing   String?  // free-text up to 500 chars
  channel   String?  // channel they last shared to
  stickerId String?
  ipHash    String?
  createdAt DateTime @default(now())

  @@index([sentiment])
  @@index([createdAt])
}

// User-submitted sticker idea when search returns empty.
model StickerSuggestion {
  id        String   @id @default(cuid())
  idea      String
  ipHash    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Download tracking records
model Download {
  id          String   @id @default(cuid())
  sticker     Sticker  @relation(fields: [stickerId], references: [id], onDelete: Cascade)
  stickerId   String
  userEmail   String?
  userPhone   String?
  userName    String?
  ipAddress   String?
  userAgent   String?
  referrer    String?
  isAnonymous Boolean  @default(false)
  downloadType String  @default("single") // single, collection, pack
  status      String   @default("completed") // pending, completed, failed
  createdAt   DateTime @default(now())

  @@index([stickerId])
  @@index([userEmail])
  @@index([userPhone])
  @@index([createdAt])
}

// Page visit tracking
model Visit {
  id         String   @id @default(cuid())
  page       String
  ipAddress  String?
  userAgent  String?
  referrer   String?
  sessionId  String?
  createdAt  DateTime @default(now())

  @@index([page])
  @@index([createdAt])
}

// Admin users with secure authentication
model Admin {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String?   // For email/password auth
  role          String    @default("admin") // admin, super_admin
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
}

// Admin sessions for auth
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  adminId      String
  admin        Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  expires      DateTime
  createdAt    DateTime @default(now())

  @@index([adminId])
}

// Sync logs for Drive sync operations
model SyncLog {
  id            String   @id @default(cuid())
  status        String   // started, completed, failed
  syncType      String   // full, incremental
  itemsSynced   Int      @default(0)
  errors        String?
  webhookId     String?  // Google webhook channel ID
  pageToken     String?  // Google Drive changes page token
  startedAt     DateTime @default(now())
  completedAt   DateTime?
}

// Key-value store for sync state
model SyncState {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

// Unsubscribe/deletion requests for privacy compliance
model UnsubscribeRequest {
  id          String   @id @default(cuid())
  email       String?
  phone       String?
  requestType String   // unsubscribe, delete_data
  status      String   @default("pending") // pending, completed
  processedAt DateTime?
  createdAt   DateTime @default(now())

  @@index([email])
  @@index([phone])
}
